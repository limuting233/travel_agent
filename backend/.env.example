

PROJECT_NAME=Travel Agent Backend
PROJECT_VERSION=0.1.0

DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_MODEL=deepseek-v4-pro

AMAP_API_BASE=https://restapi.amap.com
AMAP_API_KEY=replace-with-your-amap-key
AMAP_MCP_BASE_URL=https://mcp.amap.com/mcp
AMAP_MCP_TIMEOUT=300

XHS_MCP_URL=replace-with-your-xhs-mcp-url
XHS_MCP_TIMEOUT=300

DB_HOST=replace-with-your-db-host-address
DB_PORT=5432
DB_NAME=travel_agent
DB_USER=replace-with-your-db-user-name
DB_PASSWORD=replace-with-a-strong-db-password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_EXPIRE_MINUTES=1440

LOG_LEVEL=INFO | DEBUG
